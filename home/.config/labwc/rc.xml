<?xml version="1.0"?>

<!--
  This is a very simple config file with many options missing. For a complete
  set of options with comments, see docs/rc.xml.all
-->

<labwc_config>

  <core>
    <xwayland>no</xwayland>
    <xwaylandPersistence>yes</xwaylandPersistence>
  </core>

  <theme>
    <name>DarkLabwc</name>
    <cornerRadius>0</cornerRadius>
    <font name="JetBrains Mono" size="10" />
  </theme>

  <keyboard>
    <default />
    <!-- Use a different terminal emulator -->
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="W-i">
      <action name="Execute" command="flatpak run io.github.ungoogled_software.ungoogled_chromium" />
    </keybind>
    <keybind key="W-o">
      <action name="Execute" command="fuzzel"/>
    </keybind>
    <keybind key="W-s">
	<action name="Execute" command="/home/vm/.config/waybar/scripts/start_fuzzel.sh"/>
    </keybind>
    <keybind key="W-S-s">
	<action name="Execute" command="/home/vm/.config/waybar/scripts/power_menu.sh"/>
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="foot -T lf lf"/>
    </keybind>
    <keybind key="W-z">
      <action name="Execute" command="foot btop"/>
    </keybind>
    <keybind key="W-c">
	<action name="Execute">
	    <command>clipboard-manager</command>
    	</action>
    </keybind>
    <keybind key="W-F7">
      <action name="Execute">
	      <command>sh -c 'grim -g "$(slurp)" ~/Pictures/screenshot/Screenshot-$(date +%F-%H%M%S).png &amp;&amp; notify-send "grim" "Screenshot taken."'</command>
      </action>
    </keybind>
    <keybind key="W-F8">
      <action name="Execute">
	      <command>sh -c 'grim ~/Pictures/screenshot/Screenshot-$(date +%F-%H%M%S).png &amp;&amp; notify-send "grim" "Screenshot taken."'</command>
      </action>
    </keybind>
    <!--
      Remove a previously defined keybind
      A shorter alternative is <keybind key="W-F4" />
    -->
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <keybind key="W-f">
	<action name="ToggleFullscreen"/>
    </keybind>
    <keybind key="W-S-c">
	<action name="Reconfigure"/>
    </keybind>
    <keybind key="W-space">
	<action name="ToggleMaximize"/>
    </keybind>
    <keybind key="W-a">
        <action name="ShowMenu">
            <menu>root-menu</menu>
        </action>
    </keybind>
    <!--
    <keybind key="A-space">
	<action name="ShowMenu" menu="client-menu" atCursor="yes"/>
    </keybind>
    -->
    <repeatRate>30</repeatRate>
    <repeatDelay>250</repeatDelay>
    <keybind key="W-1"> <action name="GoToDesktop" to="1"/> </keybind>
    <keybind key="W-2"> <action name="GoToDesktop" to="2"/> </keybind>
    <keybind key="W-3"> <action name="GoToDesktop" to="3"/> </keybind>
    <keybind key="W-4"> <action name="GoToDesktop" to="4"/> </keybind>
    <keybind key="W-S-1"> <action name="SendToDesktop" to="1"/> </keybind>
    <keybind key="W-S-2"> <action name="SendToDesktop" to="2"/> </keybind>
    <keybind key="W-S-3"> <action name="SendToDesktop" to="3"/> </keybind>
    <keybind key="W-S-4"> <action name="SendToDesktop" to="4"/> </keybind>
    <keybind key="W-d">
	    <action name="Execute" command="/home/vm/.config/labwc/scripts/show-desktop.sh" />
    </keybind>
    <keybind key="XF86AudioRaiseVolume">
	<action name="Execute" command="sh -c 'wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ &amp;&amp; wp-vol'"/>
    </keybind>

    <keybind key="XF86AudioLowerVolume">
	<action name="Execute" command="sh -c 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- &amp;&amp; wp-vol'"/>
    </keybind>
    
    <keybind key="XF86AudioMute">
	<action name="Execute" command="sh -c 'wpctl set-volume @DEFAULT_AUDIO_SINK@ toggle &amp;&amp; wp-vol'"/>
    </keybind>

    <keybind key="W-h">
      <action name="SnapToEdge" direction="left" />
    </keybind>
    <keybind key="W-l">
      <action name="SnapToEdge" direction="right" />
    </keybind>
    <keybind key="W-k">
      <action name="SnapToEdge" direction="up" />
    </keybind>
    <keybind key="W-j">
      <action name="SnapToEdge" direction="down" />
    </keybind>

    <keybind key="W-S-h">
      <action name="MoveToEdge" direction="left" />
    </keybind>
    <keybind key="W-S-l">
      <action name="MoveToEdge" direction="right" />
    </keybind>
    <keybind key="W-S-k">
      <action name="MoveToEdge" direction="up" />
    </keybind>
    <keybind key="W-S-j">
      <action name="MoveToEdge" direction="down" />
    </keybind>
  </keyboard>

  <mouse>
  <default />
  <context name="Root">
    <mousebind button="Left" action="Press">
      <action name="Execute">
        <command>"/home/vm/.config/labwc/scripts/close-fuzzel.sh"</command>
      </action>
    </mousebind>
    <mousebind direction="Up" action="Scroll"></mousebind>
    <mousebind direction="Down" action="Scroll"></mousebind>
  </context>

  <context name="Frame">
    <mousebind button="W-Right" action="Press">
      <action name="Focus"/>
      <action name="Raise"/>
    </mousebind>

    <mousebind button="W-Right" action="Drag">
      <action name="Resize"/>
    </mousebind>
  </context>

</mouse>

<desktops number="4"></desktops>
<!--
  <focus>
    <followMouse>yes</followMouse>
    <followMouseRequireMovement>yes</followMouseRequireMovement>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>
-->
</labwc_config>
