sort=-time
layer=overlay
background-color=#373138D9
width=500
height=400
border-size=3
border-color=#EDD6CD
border-radius=0
icons=1
max-icon-size=50
default-timeout=15000
font="Source Han Sans CN" 15
ignore-timeout=0
text-color=#EDD6CD
margin=13,30
padding=12,20
text-alignment=left
anchor=top-right

[urgency=low]
width=230
height=300
font="Source Han Sans CN" 20
text-alignment=center
default-timeout=5000

[app-name=wp-vol]
layer=overlay
history=0
anchor=top-right
# Group all volume notifications together
group-by=app-name
# Hide the group-index
format=<b>%s</b>\n%b
text-alignment=center
margin=13,30
padding=8
width=230
font="Source Han Sans CN" 20
progress-color=#EDD6CD66
