#!/bin/sh

# Get the volume level
volume=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)

# Convert volume level to a percentage
percent=$(echo "$volume" | awk '{printf "%.0f", $2 * 100}')

# Select icon
case "$volume" in
    *"[MUTED]"*)
        notify-send \
            -t 5000 \
            -a 'wp-vol' \
            -h string:x-canonical-private-synchronous:volume \
            -h int:value:0 \
            "󰝟   Muted"
        exit 0
        ;;
    *)
        if [ "$percent" -eq 0 ]; then
            icon="󰝟"
        elif [ "$percent" -le 33 ]; then
            icon="󰕿"
        elif [ "$percent" -le 66 ]; then
            icon="󰖀"
        else
            icon="󰕾"
        fi
        ;;
esac

notify-send \
    -t 5000 \
    -a 'wp-vol' \
    -h string:x-canonical-private-synchronous:volume \
    -h int:value:$percent \
    "$icon  ${percent}%"
