# DarkLabwc theme

# Active window titlebar
window.active.title.bg: solid
window.active.title.bg.color: #3a3a3a

window.active.label.text.color: #ffffff

window.active.border.color: #505050
window.active.border.width: 1


# Inactive window titlebar
window.inactive.title.bg: solid
window.inactive.title.bg.color: #242424

window.inactive.label.text.color: #aaaaaa

window.inactive.border.color: #303030
window.inactive.border.width: 1


# Titlebar highlight/shadow
window.active.title.bg.highlight: #3a3a3a
window.active.title.bg.shadow: #303030

window.inactive.title.bg.highlight: #242424
window.inactive.title.bg.shadow: #1c1c1c


# Window buttons
window.active.button.unpressed.image.color: #ffffff
window.active.button.pressed.image.color: #aaaaaa

window.inactive.button.unpressed.image.color: #888888
window.inactive.button.pressed.image.color: #666666


# Menu colors (labwc menu)
menu.items.bg.color: #252525
menu.items.text.color: #ffffff

menu.items.active.bg.color: #3a3a3a
menu.items.active.text.color: #ffffff

menu.border.color: #505050


# General border
border.color: #303030
border.width: 3
