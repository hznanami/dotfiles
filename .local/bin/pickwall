#!/usr/bin/env bash
# pickwall - Launch swayimg gallery with current wallpaper highlighted

WALLPAPER_DIR="$HOME/Pictures/wallpaper"
CONFIG_FILE="$HOME/.config/sway/config.d/output"

if [ ! -d "$WALLPAPER_DIR" ]; then
    notify-send -h string:x-canonical-private-synchronous:swayimg-wallpaper -u critical "pickwall" "Wallpaper directory not found!"
    exit 1
fi

# Extract current wallpaper path
CURRENT_WALLPAPER=""
if [ -f "$CONFIG_FILE" ]; then
    CURRENT_WALLPAPER=$(grep -oP 'output \* bg \K[^ ]+' "$CONFIG_FILE" 2>/dev/null)
    if [ -n "$CURRENT_WALLPAPER" ] && [ ! -f "$CURRENT_WALLPAPER" ]; then
        CURRENT_WALLPAPER=""
    fi
fi

# Send notification (include current wallpaper name if available)
if [ -n "$CURRENT_WALLPAPER" ]; then
    WALL_NAME=$(basename "$CURRENT_WALLPAPER")
    notify-send -h string:x-canonical-private-synchronous:swayimg-wallpaper "pickwall" "Selecting wallpaper (current: $WALL_NAME)"
else
    notify-send -h string:x-canonical-private-synchronous:swayimg-wallpaper "pickwall" "Selecting wallpaper..."
fi

# Launch gallery with current wallpaper file (to highlight it)
if [ -n "$CURRENT_WALLPAPER" ]; then
    exec swayimg --gallery "$CURRENT_WALLPAPER"
else
    exec swayimg --gallery "$WALLPAPER_DIR"
fi
